generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String
  email    String  @unique
  password String
  rol      Rol     @default(EMPLEADO)
  activo   Boolean @default(true)

  cajaId Int?
  caja   Caja? @relation(fields: [cajaId], references: [id])

  turnosAsignados Turno[] @relation("EmpleadoToTurno")

  createdAt DateTime @default(now())
}

model Caja {
  id     Int     @id @default(autoincrement())
  nombre String
  activo Boolean @default(true)

  usuarios   Usuario[]
  turnos     Turno[]
  tiposTurno TipoTurno[] @relation("CajaToTipoTurno")

  createdAt DateTime @default(now())
}

model TipoTurno {
  id          Int     @id @default(autoincrement())
  nombre      String
  prefijo     String  @default("T")
  duracionMin Int     @default(10)
  activo      Boolean @default(true)

  turnos     Turno[]         @relation("TipoTurnoToTurno")
  contadores ContadorTurno[] @relation("TipoTurnoToContadorTurno")
  cajas      Caja[]          @relation("CajaToTipoTurno")
}

model Turno {
  id     Int         @id @default(autoincrement())
  numero Int
  codigo String
  estado EstadoTurno @default(PENDIENTE)

  tipoTurnoId Int
  tipoTurno   TipoTurno @relation("TipoTurnoToTurno", fields: [tipoTurnoId], references: [id])

  duracionEstimada   Int
  horaCreacion       DateTime  @default(now())
  horaLlamado        DateTime?
  horaInicioAtencion DateTime?
  horaFinAtencion    DateTime?
  motivoCancelacion  String?

  empleadoId Int?
  empleado   Usuario? @relation("EmpleadoToTurno", fields: [empleadoId], references: [id])

  cajaId Int?
  caja   Caja? @relation(fields: [cajaId], references: [id])

  idempotencyKeys IdempotencyKey[] @relation("TurnoToIdempotencyKey")
  anotaciones     Anotacion[]      @relation("TurnoToAnotacion")

  @@index([estado])
  @@index([tipoTurnoId])
  @@index([empleadoId])
  @@index([horaCreacion])
}

model Anotacion {
  id            Int      @id @default(autoincrement())
  contenido     String
  usuarioId     Int
  usuarioNombre String
  esAdmin       Boolean  @default(false)
  creadoEn      DateTime @default(now())

  turnoId Int
  turno   Turno @relation("TurnoToAnotacion", fields: [turnoId], references: [id])

  @@index([turnoId])
}

model ContadorTurno {
  id           Int      @id @default(autoincrement())
  fecha        DateTime
  ultimoNumero Int      @default(0)

  tipoTurnoId Int
  tipoTurno   TipoTurno @relation("TipoTurnoToContadorTurno", fields: [tipoTurnoId], references: [id])

  @@unique([tipoTurnoId, fecha])
}

model IdempotencyKey {
  id  Int    @id @default(autoincrement())
  key String

  turnoId Int?
  turno   Turno? @relation("TurnoToIdempotencyKey", fields: [turnoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([key])
}

enum EstadoTurno {
  PENDIENTE
  LLAMADO
  EN_ATENCION
  ATENDIDO
  CANCELADO
}

enum Rol {
  ADMIN
  EMPLEADO
}